<?xml version="1.0" encoding="utf-8"?>
<!--
        INTERNET only for the deck: this watch talks to the computer it was
        paired with, on the local network, and nothing else. The network's
        state, and the right to ask for Wi-Fi, to measure both ways to it.
    -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- The watch's apps, for the list: those with an icon to open -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nihil">

        <!-- A watch app on its own: nothing of it needs to be on the phone -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <!-- NIHIL on the watch: its icon, and the link NIHIL's watch face opens -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="nihil-wear" android:host="home" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DeckActivity"
            android:exported="false" />

        <!-- Exported so tools/watch can open it with adb's am start -->
        <activity
            android:name=".ProbeActivity"
            android:exported="true"
            android:launchMode="singleTask" />

        <!-- Notification access, optional: which app posted and its category, never its text -->
        <service
            android:name=".system.GlyphListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- The light on the edge over any screen: a window of the accessibility service's -->
        <service
            android:name=".system.HaloService"
            android:exported="true"
            android:label="@string/halo_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/halo_service" />
        </service>

        <!--
            The computer reaches the watch only through adb (tools/watch): the
            pairing QR's invitation in, the test's report out. Exported for
            adb's shell and refused to every app: ShellProvider checks that
            the caller is the shell.
        -->
        <provider
            android:name=".deck.ShellProvider"
            android:authorities="com.nihilshell.wear.shell"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />
    </application>
</manifest>
